# Copy this file to .env and fill in the two values from your Supabase project
# (Project Settings, then API). Without them the app still runs, but only on one phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where the web version is hosted, so invites become a tappable link.
EXPO_PUBLIC_WEB_URL=
